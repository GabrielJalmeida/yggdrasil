# Yggdrasil — configuração de ambiente
#
# A IA permanece DESABILITADA por padrão intencionalmente. A análise estática,
# o grafo, a busca e as skills determinísticas funcionam sem uma chave de IA.
# Para habilitar perguntas por IA, preencha o bloco opcional no fim deste arquivo
# (ou use as mesmas variáveis no .env da raiz) e reinicie a API/container.

# SQLite é o padrão de desenvolvimento sem configuração adicional.
# Para PostgreSQL via Docker Compose, consulte README.md (português) ou README-EN.md (inglês).
DATABASE_URL=sqlite:///./data/yggdrasil.db

# Token GitHub opcional. Repositórios públicos funcionam sem ele dentro dos
# limites de taxa do GitHub. Use um token com acesso de leitura mínimo necessário.
GITHUB_TOKEN=

# Origens permitidas para chamadas feitas pelo navegador.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites de segurança da ingestão; valores em bytes, salvo MAX_FILES e diretórios.
MAX_ARCHIVE_BYTES=20971520
MAX_FILES=1000
MAX_TREE_DIRECTORIES=2000
MAX_FILE_BYTES=262144
MAX_TOTAL_TEXT_BYTES=8388608
MAX_TOTAL_UNPACKED_BYTES=52428800

# IA opcional — esta configuração mantém a IA desligada.
# ATENÇÃO: AI_PROVIDER=disabled significa que nenhuma pergunta chamará um modelo.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_REASONING_EFFORT=low
AI_MAX_CONTEXT_CHARS=14000
AI_MAX_EVIDENCE_ITEMS=8

# Exemplo para o caminho nativo da API Google Gemini (descomente e ajuste para usar):
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sua-chave-do-Google-AI-Studio
# AI_BASE_URL=https://generativelanguage.googleapis.com
# AI_MODEL=gemini-3.6-flash
# AI_TIMEOUT_SECONDS=90
# AI_REASONING_EFFORT=medium
#
# O ID de modelo deve estar disponível para a sua conta/região. O valor acima é um
# exemplo testado no ambiente de desenvolvimento em 27/10/2026, não uma garantia
# de disponibilidade universal. Nunca coloque uma chave real neste arquivo nem
# versione seu arquivo .env. A chave fica apenas no backend.
