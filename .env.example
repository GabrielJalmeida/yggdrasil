# SQLite is the zero-configuration default. For PostgreSQL, see README.md.
DATABASE_URL=sqlite:///./data/yggdrasil.db

# Optional GitHub token. Public repositories work without it within GitHub's rate limits.
# Use a fine-grained token with read-only public repository access if needed.
GITHUB_TOKEN=

# Optional: origins allowed to call the API in a browser.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Analysis safety limits. Keep these modest for local development.
MAX_ARCHIVE_BYTES=20971520
MAX_FILES=1000
MAX_TREE_DIRECTORIES=2000
MAX_FILE_BYTES=262144
MAX_TOTAL_TEXT_BYTES=8388608
MAX_TOTAL_UNPACKED_BYTES=52428800

# Optional AI questions (v0.7.0); Gemini retries transient 5xx once. Disabled by default; deterministic analysis works without AI.
# For an OpenAI-compatible hosted provider, configure the API key, model and base URL.
# Gemini uses the native generateContent API: set AI_BASE_URL=https://generativelanguage.googleapis.com and choose a model ID available to your account (for example, gemini-3.5-flash-lite).
# For a trusted local OpenAI-compatible server, the key may be omitted.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_REASONING_EFFORT=low
AI_MAX_CONTEXT_CHARS=14000
AI_MAX_EVIDENCE_ITEMS=8
